<mvc:View
    controllerName="zpncnd.datos.maestros.pncnddatosmaestros.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    height="100%">

    <Page showHeader="false" enableScrolling="false">
        <content>
            <VBox height="100%" fitContainer="true">

                <!-- ====== SELECTOR DE TABLA ====== -->
                <Toolbar class="sapMTBHeader-CTX">
                    <Label text="Tabla:" class="sapUiSmallMarginEnd"/>
                    <Input
                        id="inpTablaActual"
                        value="{tablas>/selectedDesc}"
                        editable="false"
                        showValueHelp="true"
                        valueHelpRequest=".onAbrirSelectorTabla"
                        placeholder="Seleccionar tabla..."
                        width="28rem"/>
                </Toolbar>

                <!-- ====== ÁREA DE TABLA DINÁMICA ====== -->
                <VBox id="containerTable" fitContainer="true" width="100%">
                    <!-- SmartFilterBar + SmartTable generados dinámicamente -->
                </VBox>

            </VBox>
        </content>
    </Page>

</mvc:View>
