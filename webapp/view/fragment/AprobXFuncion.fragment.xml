<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:comp="sap.ui.comp.smarttable"
    xmlns:sfb="sap.ui.comp.smartfilterbar">

    <VBox width="100%" class="pncndFragContent">

        <sfb:SmartFilterBar
            id="sfbFuncion"
            entitySet="PNCND_APROB_X_FUNCION"
            showGoOnFB="true"
            showRestoreOnFB="true"
            showFilterConfiguration="false">
            <sfb:controlConfiguration>
                <sfb:ControlConfiguration key="cod_concepto"  label="Cod. Concepto"    visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="id_tipo_aprob" label="Tipo de Aprobador" visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="nivel"         label="Nivel"             visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="mail"          label="Mail"              visibleInAdvancedArea="true"/>
            </sfb:controlConfiguration>
        </sfb:SmartFilterBar>

        <SearchField id="sfSearchFuncion" width="100%" liveChange=".onSearchFuncion"
            placeholder="Buscar en todos los campos..." class="sapUiSmallMarginBottom"/>

        <VBox class="pncndTableScroll">

            <comp:SmartTable
                id="stFuncion"
                entitySet="PNCND_APROB_X_FUNCION"
                tableType="ResponsiveTable"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                enableAutoBinding="true"
                showRowCount="true"
                header="Aprobadores por Función">

                <comp:customToolbar>
                    <OverflowToolbar design="Transparent">
                        <ToolbarSpacer/>
                        <Button text="Mod. Masiva"  icon="sap-icon://edit"     press=".onModMasivaFuncion"/>
                        <ToolbarSeparator/>
                        <Button text="Template"     icon="sap-icon://download" press=".onDescargarTemplateFuncion"/>
                        <Button text="Carga Masiva" icon="sap-icon://upload"   press=".onCargaMasivaFuncion"/>
                    </OverflowToolbar>
                </comp:customToolbar>

                <Table id="_tblFuncion" fixedLayout="false" mode="MultiSelect"
                       sticky="ColumnHeaders,HeaderToolbar">
                    <columns>
                        <Column width="15rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"cod_concepto","leadingProperty":"cod_concepto","sortProperty":"cod_concepto","filterProperty":"cod_concepto","width":"15rem"}'/>
                            </customData>
                            <Text text="Cod. Concepto"/>
                        </Column>
                        <Column width="15rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"id_tipo_aprob","leadingProperty":"id_tipo_aprob","sortProperty":"id_tipo_aprob","filterProperty":"id_tipo_aprob","width":"15rem"}'/>
                            </customData>
                            <Text text="Tipo de Aprobador"/>
                        </Column>
                        <Column width="15rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"nivel","leadingProperty":"nivel","sortProperty":"nivel","filterProperty":"nivel","width":"15rem"}'/>
                            </customData>
                            <Text text="Nivel"/>
                        </Column>
                        <Column>
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"mail","leadingProperty":"mail","sortProperty":"mail","filterProperty":"mail"}'/>
                            </customData>
                            <Text text="Mail"/>
                        </Column>
                        <Column width="8rem" hAlign="Center">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"acciones","sortProperty":null,"filterProperty":null}'/>
                            </customData>
                            <Text text="Acciones"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{cod_concepto}"  wrapping="false"/>
                                <Text text="{id_tipo_aprob}" wrapping="false"/>
                                <Text text="{nivel}"         wrapping="false"/>
                                <Text text="{mail}"          wrapping="false"/>
                                <HBox justifyContent="Center">
                                    <Button icon="sap-icon://edit"   press=".onEditarAprobFuncion"   class="sapUiTinyMarginEnd"/>
                                    <Button icon="sap-icon://delete" press=".onEliminarAprobFuncion" type="Reject"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </comp:SmartTable>

        </VBox>

    </VBox>

</core:FragmentDefinition>
