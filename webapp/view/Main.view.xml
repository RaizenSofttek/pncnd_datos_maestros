<mvc:View
    controllerName="zpncnd.datos.maestros.pncnddatosmaestros.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <Page showHeader="false" enableScrolling="false">
        <content>
            <VBox width="100%" class="pncndLayout">

                <!-- ====== BARRA DE SELECCIÓN ====== -->
                <Toolbar>
                    <Label text="Tabla:" class="sapUiSmallMarginEnd"/>
                    <Select
                        id="selTabla"
                        width="20rem"
                        forceSelection="false"
                        items="{
                            path: '/PNCND_TABLAS_MAESTRAS',
                            sorter: { path: 'descripcion' }
                        }">
                        <core:Item key="{nombre}" text="{descripcion}"/>
                    </Select>
                    <ToolbarSpacer width="1rem"/>
                    <Button
                        text="GO"
                        type="Emphasized"
                        press=".onApplyFilters"/>
                    <Button
                        icon="sap-icon://clear-filter"
                        type="Transparent"
                        tooltip="Limpiar"
                        press=".onClearFilters"/>
                </Toolbar>

                <!-- ====== CONTENEDOR DE FRAGMENT ====== -->
                <VBox id="fragmentContainer" width="100%" class="pncndFragArea"/>

            </VBox>
        </content>
    </Page>

</mvc:View>
