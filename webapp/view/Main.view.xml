<mvc:View
    controllerName="zpncnd.datos.maestros.pncnddatosmaestros.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <Page showHeader="false" enableScrolling="false">
        <content>
            <VBox height="100%" fitContainer="true">

                <!-- ====== SELECTOR DE TABLA ====== -->
                <Panel headerText="Seleccionar Tabla" class="sapUiNoContentPadding dmSelectorPanel">
                    <List
                        id="lb_tabla_sel"
                        mode="SingleSelectLeft"
                        selectionChange=".onTablaSelChange"
                        showSeparators="Inner"
                        items="{tablas>/tablas}">
                        <StandardListItem
                            title="{tablas>descripcion}"
                            description="{tablas>id_tabla}"
                            type="Active"/>
                    </List>
                </Panel>

                <!-- ====== ÁREA DE TABLA DINÁMICA ====== -->
                <VBox id="containerTable" fitContainer="true" width="100%" class="dmTableArea">
                    <!-- SmartFilterBar + SmartTable se generan dinámicamente -->
                </VBox>

            </VBox>
        </content>
    </Page>

</mvc:View>
