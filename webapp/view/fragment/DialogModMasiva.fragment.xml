<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">

    <Dialog id="dlgModMasiva" title="Modificación Masiva" contentWidth="440px" resizable="true">
        <content>
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
                <MessageStrip
                    text="El valor ingresado actualizará todos los registros seleccionados."
                    type="Warning" showIcon="true" showCloseButton="false"
                    class="sapUiSmallMarginBottom"/>
                <List showSeparators="None" items="{modMasiva>/campos}">
                    <InputListItem label="{modMasiva>label}">
                        <Input value="{modMasiva>value}"
                               maxLength="{modMasiva>maxLength}"
                               placeholder="{modMasiva>hint}"
                               width="100%"/>
                    </InputListItem>
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button text="Aceptar" type="Emphasized" press=".onAceptarModMasiva"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press=".onCancelarModMasiva"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
