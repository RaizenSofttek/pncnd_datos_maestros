<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:comp="sap.ui.comp.smarttable"
    xmlns:sfb="sap.ui.comp.smartfilterbar">

    <VBox width="100%" class="pncndFragContent">

        <sfb:SmartFilterBar
            id="sfbAprobadoresAudit"
            entitySet="PNCND_APROBADORES_AUDIT"
            showGoOnFB="true"
            showRestoreOnFB="true"
            showFilterConfiguration="false">
            <sfb:controlConfiguration>
                <sfb:ControlConfiguration key="accion"               label="Acción"             visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="fecha_modificacion"   label="Fecha Modificación" visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="usuario_modificacion" label="Modificado por"     visibleInAdvancedArea="true"/>
            </sfb:controlConfiguration>
        </sfb:SmartFilterBar>

        <SearchField id="sfSearchAprobadoresAudit" width="100%" liveChange=".onSearchAprobadoresAudit"
            placeholder="Buscar en acción, usuario, mails, nombres..." class="sapUiSmallMarginBottom"/>

        <VBox class="pncndTableScroll">

            <comp:SmartTable
                id="stAprobadoresAudit"
                entitySet="PNCND_APROBADORES_AUDIT"
                tableType="ResponsiveTable"
                enableExport="true"
                beforeExport=".onBeforeExportSmartTable"
                useVariantManagement="false"
                useTablePersonalisation="true"
                enableAutoBinding="true"
                showRowCount="true"
                header="Auditoría - Aprobadores">

                <Table id="_tblAprobadoresAudit" fixedLayout="true" mode="None"
                       sticky="ColumnHeaders,HeaderToolbar" growing="true" growingThreshold="40">
                    <columns>
                        <Column width="9rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"accion","leadingProperty":"accion","sortProperty":"accion","filterProperty":"accion","width":"9rem"}'/></customData>
                            <Text text="Acción" wrapping="false"/>
                        </Column>
                        <Column width="14rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"fecha_modificacion","leadingProperty":"fecha_modificacion","sortProperty":"fecha_modificacion","filterProperty":"fecha_modificacion","width":"14rem"}'/></customData>
                            <Text text="Fecha Modificación" wrapping="false"/>
                        </Column>
                        <Column width="18rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"usuario_modificacion","leadingProperty":"usuario_modificacion","sortProperty":"usuario_modificacion","filterProperty":"usuario_modificacion","width":"18rem"}'/></customData>
                            <Text text="Modificado por" wrapping="false"/>
                        </Column>
                        <Column width="20rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"mail_nuevo","leadingProperty":"mail_nuevo","sortProperty":"mail_nuevo","width":"20rem"}'/></customData>
                            <Text text="Mail (Actual)" wrapping="false"/>
                        </Column>
                        <Column width="14rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"id_tipo_aprob_nuevo","leadingProperty":"id_tipo_aprob_nuevo","sortProperty":"id_tipo_aprob_nuevo","width":"14rem"}'/></customData>
                            <Text text="Tipo Aprobador (Actual)" wrapping="false"/>
                        </Column>
                        <Column width="18rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"nombre_nuevo","leadingProperty":"nombre_nuevo","sortProperty":"nombre_nuevo","width":"18rem"}'/></customData>
                            <Text text="Nombre (Actual)" wrapping="false"/>
                        </Column>
                        <Column width="20rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"mail_anterior","leadingProperty":"mail_anterior","sortProperty":"mail_anterior","width":"20rem"}'/></customData>
                            <Text text="Mail (Anterior)" wrapping="false"/>
                        </Column>
                        <Column width="15rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"id_tipo_aprob_anterior","leadingProperty":"id_tipo_aprob_anterior","sortProperty":"id_tipo_aprob_anterior","width":"15rem"}'/></customData>
                            <Text text="Tipo Aprobador (Anterior)" wrapping="false"/>
                        </Column>
                        <Column width="18rem">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"nombre_anterior","leadingProperty":"nombre_anterior","sortProperty":"nombre_anterior","width":"18rem"}'/></customData>
                            <Text text="Nombre (Anterior)" wrapping="false"/>
                        </Column>

                        <!-- Oculta por defecto: sigue disponible desde el panel de configuración -->
                        <Column width="5rem" visible="false">
                            <customData><core:CustomData key="p13nData" value='\{"columnKey":"id","leadingProperty":"id","sortProperty":"id","width":"5rem"}'/></customData>
                            <Text text="ID" wrapping="false"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{accion}"                  wrapping="false"/>
                                <Text text="{path:'fecha_modificacion', formatter:'.formatFecha'}" wrapping="false"/>
                                <Text text="{usuario_modificacion}"    wrapping="false"/>
                                <Text text="{mail_nuevo}"              wrapping="false"/>
                                <Text text="{id_tipo_aprob_nuevo}"     wrapping="false"/>
                                <Text text="{nombre_nuevo}"            wrapping="false"/>
                                <Text text="{mail_anterior}"           wrapping="false"/>
                                <Text text="{id_tipo_aprob_anterior}"  wrapping="false"/>
                                <Text text="{nombre_anterior}"         wrapping="false"/>
                                <Text text="{id}"                      wrapping="false"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </comp:SmartTable>

        </VBox>

    </VBox>

</core:FragmentDefinition>
