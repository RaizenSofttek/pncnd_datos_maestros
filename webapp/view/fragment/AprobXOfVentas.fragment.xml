<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:comp="sap.ui.comp.smarttable"
    xmlns:sfb="sap.ui.comp.smartfilterbar">

    <VBox width="100%" class="pncndFragContent">

        <sfb:SmartFilterBar
            id="sfbOfVentas"
            entitySet="PNCND_APROB_X_OF_VENTAS"
            showGoOnFB="true"
            showRestoreOnFB="true"
            showFilterConfiguration="false">
            <sfb:controlConfiguration>
                <sfb:ControlConfiguration key="vkorg"         label="Org. Ventas"    visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="vtweg"         label="Canal"          visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="spart"         label="Sector"         visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="id_tipo_aprob" label="Tipo Aprobador" visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="nivel"         label="Nivel"          visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="vkbur"         label="Of. de Ventas"  visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="bran2"         label="División"       visibleInAdvancedArea="true"/>
                <sfb:ControlConfiguration key="mail"          label="Mail"           visibleInAdvancedArea="true"/>
            </sfb:controlConfiguration>
        </sfb:SmartFilterBar>

        <SearchField id="sfSearchOfVentas" width="100%" liveChange=".onSearchOfVentas"
            placeholder="Buscar en todos los campos..." class="sapUiSmallMarginBottom"/>

        <VBox class="pncndTableScroll">

            <comp:SmartTable
                id="stOfVentas"
                entitySet="PNCND_APROB_X_OF_VENTAS"
                tableType="ResponsiveTable"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                enableAutoBinding="true"
                showRowCount="true"
                header="Aprobadores por Oficina de Ventas">

                <comp:customToolbar>
                    <OverflowToolbar design="Transparent">
                        <ToolbarSpacer/>
                        <Button text="Mod. Masiva"  icon="sap-icon://edit"     press=".onModMasivaOfVentas"/>
                        <ToolbarSeparator/>
                        <Button text="Template"     icon="sap-icon://download" press=".onDescargarTemplateOfVentas"/>
                        <Button text="Carga Masiva" icon="sap-icon://upload"   press=".onCargaMasivaOfVentas"/>
                    </OverflowToolbar>
                </comp:customToolbar>

                <Table id="_tblOfVentas" fixedLayout="false" mode="MultiSelect">
                    <columns>
                        <Column width="7rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"vkorg","leadingProperty":"vkorg","sortProperty":"vkorg","filterProperty":"vkorg","width":"7rem"}'/>
                            </customData>
                            <Text text="Org. Ventas"/>
                        </Column>
                        <Column width="7rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"vtweg","leadingProperty":"vtweg","sortProperty":"vtweg","filterProperty":"vtweg","width":"7rem"}'/>
                            </customData>
                            <Text text="Canal"/>
                        </Column>
                        <Column width="7rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"spart","leadingProperty":"spart","sortProperty":"spart","filterProperty":"spart","width":"7rem"}'/>
                            </customData>
                            <Text text="Sector"/>
                        </Column>
                        <Column width="10rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"id_tipo_aprob","leadingProperty":"id_tipo_aprob","sortProperty":"id_tipo_aprob","filterProperty":"id_tipo_aprob","width":"10rem"}'/>
                            </customData>
                            <Text text="Tipo Aprobador"/>
                        </Column>
                        <Column width="7rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"nivel","leadingProperty":"nivel","sortProperty":"nivel","filterProperty":"nivel","width":"7rem"}'/>
                            </customData>
                            <Text text="Nivel"/>
                        </Column>
                        <Column width="10rem">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"vkbur","leadingProperty":"vkbur","sortProperty":"vkbur","filterProperty":"vkbur","width":"10rem"}'/>
                            </customData>
                            <Text text="Of. de Ventas"/>
                        </Column>
                        <Column>
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"bran2","leadingProperty":"bran2","sortProperty":"bran2","filterProperty":"bran2"}'/>
                            </customData>
                            <Text text="División"/>
                        </Column>
                        <Column>
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"mail","leadingProperty":"mail","sortProperty":"mail","filterProperty":"mail"}'/>
                            </customData>
                            <Text text="Mail"/>
                        </Column>
                        <Column width="8rem" hAlign="Center">
                            <customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"acciones","sortProperty":null,"filterProperty":null}'/>
                            </customData>
                            <Text text="Acciones"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{vkorg}"         wrapping="false"/>
                                <Text text="{vtweg}"         wrapping="false"/>
                                <Text text="{spart}"         wrapping="false"/>
                                <Text text="{id_tipo_aprob}" wrapping="false"/>
                                <Text text="{nivel}"         wrapping="false"/>
                                <Text text="{vkbur}"         wrapping="false"/>
                                <Text text="{bran2}"         wrapping="false"/>
                                <Text text="{mail}"          wrapping="false"/>
                                <HBox justifyContent="Center">
                                    <Button icon="sap-icon://edit"   press=".onEditarAprobOfVentas"   class="sapUiTinyMarginEnd"/>
                                    <Button icon="sap-icon://delete" press=".onEliminarAprobOfVentas" type="Reject"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </comp:SmartTable>

        </VBox>

    </VBox>

</core:FragmentDefinition>
